---
import { site } from '../config/site';
---

<section class="bg-pine py-24 text-center text-cream">
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="mx-auto max-w-2xl font-serif text-4xl leading-tight tracking-tight sm:text-5xl">
      Find out what your business is answering right now.
    </h2>
    <p class="mt-8">
      <a class="btn btn-amber" href={`mailto:${site.contactEmail}?subject=Free%20Answer%20Audit`}>
        Request my free Answer Audit
      </a>
    </p>
  </div>
</section>
